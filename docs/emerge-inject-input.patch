diff --git a/lib/emerge_skia.ex b/lib/emerge_skia.ex
index 5806c2b..21f1b44 100644
--- a/lib/emerge_skia.ex
+++ b/lib/emerge_skia.ex
@@ -761,6 +761,31 @@ defmodule EmergeSkia do
     |> apply(:set_input_target, [renderer, pid])
   end
 
+  @doc """
+  Feed a raw input event into a running renderer, as if its backend had produced it.
+
+  `event` has the shape the renderer itself reports raw input in (see
+  `set_input_target/2`): `{:cursor_pos, {x, y}}`,
+  `{:cursor_button, {button, action, mods, {x, y}}}`,
+  `{:cursor_scroll, {{dx, dy}, {x, y}}}`, `{:touch, {id, :down | :move | :up | :cancel, {x, y}}}`,
+  `{:key, {key, action, mods}}`, `{:text_commit, {text, mods}}`,
+  `{:cursor_entered, boolean}` or `{:focused, boolean}`. Coordinates are in the
+  renderer's logical pixels and may be integers; `action` may also be `:press` or
+  `:release`.
+
+  The renderer hit-tests it against its tree and handles it like native input:
+  element events (`on_press`, `on_click`, focus, text editing, scrolling) are sent to
+  the input target, and raw input passes the input mask. This lets input received
+  elsewhere, for example on another machine's display, drive a headless renderer.
+
+  Returns `{:error, :invalid_event}` for an unknown shape and `{:error, :unsupported}`
+  on the macOS host.
+  """
+  @spec inject_input(renderer(), tuple()) :: :ok | {:error, term()}
+  def inject_input(renderer, event) when is_tuple(event) do
+    Transport.for_renderer(renderer).inject_input(renderer, event)
+  end
+
   @doc """
   Set the target process to receive native renderer log messages.
 
