diff --git a/native/emerge_skia/src/lib.rs b/native/emerge_skia/src/lib.rs
index 6863b2e..d91ce33 100644
--- a/native/emerge_skia/src/lib.rs
+++ b/native/emerge_skia/src/lib.rs
@@ -3845,6 +3845,27 @@ fn set_input_target(
     atoms::ok()
 }
 
+/// Feed a raw input event into the renderer's event actor, as if its backend had
+/// produced it: hit-testing, element events (`{:emerge_skia_event, {id, :press}}`
+/// and friends), focus, scrolling and raw-input delivery all run as for native
+/// input. Works with every backend, including headless.
+#[rustler::nif]
+fn renderer_inject_input(
+    renderer: ResourceArc<RendererResource>,
+    event: input::InputEvent,
+) -> NifResult<Atom> {
+    if !renderer.running_flag.load(Ordering::Acquire) {
+        return Err(rustler::Error::Term(Box::new("renderer is not running")));
+    }
+
+    send_event(
+        &renderer.event_tx,
+        EventMsg::InputEvent(event.normalize_scroll()),
+        renderer.log_input,
+    );
+    Ok(atoms::ok())
+}
+
 #[rustler::nif]
 fn set_log_target(renderer: ResourceArc<RendererResource>, pid: Option<LocalPid>) -> Atom {
     renderer.native_log.set_target(pid);
diff --git a/test/emerge_skia/inject_input_test.exs b/test/emerge_skia/inject_input_test.exs
new file mode 100644
index 0000000..13254c9
--- /dev/null
+++ b/test/emerge_skia/inject_input_test.exs
@@ -0,0 +1,69 @@
+defmodule EmergeSkia.InjectInputTest do
+  use ExUnit.Case, async: false
+  use Emerge.UI
+
+  alias Emerge.Config
+  alias Emerge.Engine.NodeId
+
+  setup do
+    config = %Config{
+      output: %Config.Headless{target: self(), size: {100, 60}},
+      renderer: [api: :raster],
+      input: [events: [:pointer_button, :key]],
+      assets: [otp_app: :emerge]
+    }
+
+    {:ok, renderer} = EmergeSkia.start(config)
+    on_exit(fn -> EmergeSkia.stop(renderer) end)
+    :ok = EmergeSkia.set_input_target(renderer, self())
+
+    tree =
+      row([width(fill()), height(fill())], [
+        el([key(:a), width(px(50)), height(fill()), Event.on_press(:a)], none()),
+        el([key(:b), width(px(50)), height(fill()), Event.on_press(:b)], none())
+      ])
+
+    {diff_state, assigned} = EmergeSkia.upload_tree(renderer, tree)
+    assert_receive {:emerge_skia_frame, _}, 5_000
+
+    ids =
+      Map.new(assigned.children, fn child -> {child.key, NodeId.encode(child.id)} end)
+
+    %{renderer: renderer, ids: ids, diff_state: diff_state}
+  end
+
+  test "an injected click is hit-tested into element events", %{renderer: renderer, ids: ids} do
+    b = ids.b
+
+    for event <- [
+          {:cursor_pos, {75, 30}},
+          {:cursor_button, {:left, :press, [], {75, 30}}},
+          {:cursor_button, {:left, 0, [], {75.0, 30.0}}}
+        ],
+        do: assert(:ok = EmergeSkia.inject_input(renderer, event))
+
+    assert_receive {:emerge_skia_event, {^b, :press}}, 2_000
+    refute_received {:emerge_skia_event, {_, :press}}
+
+    # Raw input passes the input mask as for native input.
+    assert_received {:emerge_skia_event, {:cursor_button, {:left, 1, [], {75.0, 30.0}}}}
+  end
+
+  test "keys and touch are accepted; unknown shapes are not", %{renderer: renderer, ids: ids} do
+    a = ids.a
+    assert :ok = EmergeSkia.inject_input(renderer, {:key, {:enter, 1, [:shift]}})
+    assert_receive {:emerge_skia_event, {:key, {:enter, 1, [:shift]}}}, 2_000
+
+    assert :ok = EmergeSkia.inject_input(renderer, {:touch, {7, :down, {10, 10}}})
+    assert :ok = EmergeSkia.inject_input(renderer, {:touch, {7, :up, {10, 10}}})
+    assert_receive {:emerge_skia_event, {^a, :press}}, 2_000
+
+    assert {:error, :invalid_event} = EmergeSkia.inject_input(renderer, {:resized, {1, 1, 1.0}})
+    assert {:error, :invalid_event} = EmergeSkia.inject_input(renderer, {:cursor_pos, :nope})
+  end
+
+  test "a stopped renderer refuses input", %{renderer: renderer} do
+    :ok = EmergeSkia.stop(renderer)
+    assert {:error, _} = EmergeSkia.inject_input(renderer, {:cursor_pos, {1, 1}})
+  end
+end
