 // ============================================================================
@@ -503,6 +505,125 @@ impl Encoder for InputEvent {
     }
 }
 
+// ============================================================================
+// Decoder Implementation (injected input)
+// ============================================================================
+
+/// Decodes the raw input terms this module encodes (`{:cursor_pos, {x, y}}`,
+/// `{:cursor_button, {button, action, mods, {x, y}}}`, ...), so input received
+/// elsewhere can be fed into a running renderer. Coordinates may be integers or
+/// floats; actions may be `0`/`1` or `:release`/`:press`. Window-system events
+/// (`resized`, IME preedit) are not accepted.
+impl<'a> rustler::Decoder<'a> for InputEvent {
+    fn decode(term: Term<'a>) -> rustler::NifResult<Self> {
+        let (tag, payload): (Atom, Term<'a>) = term.decode()?;
+
+        if tag == cursor_pos() {
+            let (x, y) = decode_point(payload)?;
+            Ok(InputEvent::CursorPos { x, y })
+        } else if tag == cursor_button() {
+            let (button, action, mods, point): (Atom, Term<'a>, Term<'a>, Term<'a>) =
+                payload.decode()?;
+            let (x, y) = decode_point(point)?;
+            let button = button.to_term(term.get_env()).atom_to_string()?;
+            Ok(InputEvent::CursorButton {
+                button: pointer::canonical_button_label(&button).to_string(),
+                action: decode_action(action)?,
+                mods: decode_mods(mods)?,
+                x,
+                y,
+            })
+        } else if tag == cursor_scroll() {
+            let (delta, point): (Term<'a>, Term<'a>) = payload.decode()?;
+            let (dx, dy) = decode_point(delta)?;
+            let (x, y) = decode_point(point)?;
+            Ok(InputEvent::CursorScroll { dx, dy, x, y })
+        } else if tag == key() {
+            let (key_atom, action, mods): (Atom, Term<'a>, Term<'a>) = payload.decode()?;
+            let name = key_atom.to_term(term.get_env()).atom_to_string()?;
+            Ok(InputEvent::Key {
+                key: CanonicalKey::from_atom_name(&name).unwrap_or(CanonicalKey::Unknown),
+                action: decode_action(action)?,
+                mods: decode_mods(mods)?,
+            })
+        } else if tag == text_commit() {
+            let (text, mods): (String, Term<'a>) = payload.decode()?;
+            Ok(InputEvent::TextCommit {
+                text,
+                mods: decode_mods(mods)?,
+            })
+        } else if tag == touch() {
+            let (id, phase, point): (u64, Atom, Term<'a>) = payload.decode()?;
+            let (x, y) = decode_point(point)?;
+            let phase = if phase == down() {
+                TouchPhase::Down
+            } else if phase == move_touch() {
+                TouchPhase::Move
+            } else if phase == up() {
+                TouchPhase::Up
+            } else if phase == cancel() {
+                TouchPhase::Cancel
+            } else {
+                return Err(rustler::Error::BadArg);
+            };
+            Ok(InputEvent::Touch { id, phase, x, y })
+        } else if tag == cursor_entered() {
+            Ok(InputEvent::CursorEntered {
+                entered: payload.decode()?,
+            })
+        } else if tag == focused() {
+            Ok(InputEvent::Focused {
+                focused: payload.decode()?,
+            })
+        } else {
+            Err(rustler::Error::BadArg)
+        }
+    }
+}
+
+fn decode_number(term: Term<'_>) -> rustler::NifResult<f32> {
+    match term.decode::<f64>() {
+        Ok(value) => Ok(value as f32),
+        Err(_) => term.decode::<i64>().map(|value| value as f32),
+    }
+}
+
+fn decode_point(term: Term<'_>) -> rustler::NifResult<(f32, f32)> {
+    let (x, y): (Term<'_>, Term<'_>) = term.decode()?;
+    Ok((decode_number(x)?, decode_number(y)?))
+}
+
+fn decode_action(term: Term<'_>) -> rustler::NifResult<u8> {
+    if let Ok(action) = term.decode::<u8>() {
+        return Ok(action);
+    }
+    let action: Atom = term.decode()?;
+    if action == press() {
+        Ok(ACTION_PRESS)
+    } else if action == release() {
+        Ok(ACTION_RELEASE)
+    } else {
+        Err(rustler::Error::BadArg)
+    }
+}
+
+fn decode_mods(term: Term<'_>) -> rustler::NifResult<u8> {
+    let mods: Vec<Atom> = term.decode()?;
+    Ok(mods.into_iter().fold(0, |bits, modifier| {
+        bits | if modifier == shift() {
+            MOD_SHIFT
+        } else if modifier == ctrl() {
+            MOD_CTRL
+        } else if modifier == alt() {
+            MOD_ALT
+        } else if modifier == meta() {
+            MOD_META
+        } else {
+            0
+        }
+    }))
+}
+
